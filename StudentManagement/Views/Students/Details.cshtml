@model Student

@{
    ViewData["Title"] = "بيانات الطالب";
}

<h1>بيانات الطالب</h1>

<div class="card">
    <div class="card-body">
        <h3 class="card-title">@Model.FullName</h3>
        <hr />
        <dl class="row mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Email)</dt>
            <dd class="col-sm-9 ltr-text">@Model.Email</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Department)</dt>
            <dd class="col-sm-9">@Model.Department.Name</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.BirthDate)</dt>
            <dd class="col-sm-9">@Model.BirthDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Gpa)</dt>
            <dd class="col-sm-9">@Model.Gpa.ToString("0.00")</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.EnrollmentDate)</dt>
            <dd class="col-sm-9">@Model.EnrollmentDate.ToString("yyyy-MM-dd")</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">تعديل</a>
    <a asp-action="Index" class="btn btn-secondary">رجوع</a>
</div>