@model Student

@{
    ViewData["Title"] = "حذف طالب";
}

<h1>هل أنت متأكد من حذف هذا الطالب؟</h1>

<div class="card border-danger">
    <div class="card-body">
        <h4>@Model.FullName</h4>
        <p class="mb-1">القسم: @Model.Department.Name</p>
        <p class="text-muted mb-0 ltr-text">@Model.Email</p>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">نعم، احذف</button>
    <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
</form>