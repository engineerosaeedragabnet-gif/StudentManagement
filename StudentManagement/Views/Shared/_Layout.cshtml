@{
    // ---------- بيانات المسار الحالي (عشان نحدد اللينك النشط) ----------
    var routeController = ViewContext.RouteData.Values["controller"]?.ToString();

    bool IsController(string name) =>
        string.Equals(routeController, name, StringComparison.OrdinalIgnoreCase);

    var isStudents = IsController("Students");
    var isDepartments = IsController("Departments");

    // ---------- كلمة البحث الحالية (لو موجودة في الرابط) ----------
    var currentSearch = Context.Request.Query["searchTerm"].ToString();

    // ---------- رسائل TempData (بتتقرا مرة واحدة) ----------
    var successMessage = TempData["Success"] as string;
    var errorMessage = TempData["Error"] as string;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="نظام إدارة الطلاب والأقسام: إضافة وتعديل وبحث وترتيب وتقسيم صفحات." />
    <meta name="theme-color" content="#0F4C5C" />
    <title>@ViewData["Title"] - إدارة الطلاب</title>

    <!-- تطبيق الوضع الداكن قبل رسم الصفحة (عشان ما يحصلش وميض) -->
    <script>
            (function () {
                try {
                    var saved = localStorage.getItem('theme');
                    var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                    var theme = saved || (prefersDark ? 'dark' : 'light');
                    document.documentElement.setAttribute('data-bs-theme', theme);
                } catch (e) { /* التخزين غير متاح: نكمل بالوضع الفاتح */ }
            })();
    </script>

    <!-- الخط -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5.3 RTL -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />

    <!-- ستايل المشروع -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" />
</head>
<body>
    <a class="skip-link" href="#main-content">تخطَّ إلى المحتوى</a>

    <!-- ================= الشريط العلوي ================= -->
    <header class="app-header sticky-top">
        <nav class="navbar navbar-expand-lg app-navbar" aria-label="التنقل الرئيسي">
            <div class="container">

                <a class="navbar-brand app-brand" asp-controller="Students" asp-action="Index">
                    <span class="app-brand-mark" aria-hidden="true">
                        <!-- أيقونة قبعة التخرج -->
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 9l10-5 10 5-10 5z" />
                            <path d="M6 11.5V16c0 1.4 2.7 3 6 3s6-1.6 6-3v-4.5" />
                            <path d="M22 9v6" />
                        </svg>
                    </span>
                    إدارة الطلاب
                </a>

                <button class="navbar-toggler app-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="فتح القائمة">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">

                    <!-- روابط التنقل -->
                    <ul class="navbar-nav app-nav me-lg-3">
                        <li class="nav-item">
                            <a class="nav-link @(isStudents ? "active" : "")"
                               aria-current="@(isStudents ? "page" : null)"
                               asp-controller="Students" asp-action="Index">الطلاب</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isDepartments ? "active" : "")"
                               aria-current="@(isDepartments ? "page" : null)"
                               asp-controller="Departments" asp-action="Index">الأقسام</a>
                        </li>
                    </ul>

                    <!-- بحث سريع + أدوات (في الجهة المقابلة) -->
                    <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2 ms-lg-auto mt-3 mt-lg-0">

                        <form asp-controller="Students" asp-action="Index" method="get"
                              class="app-search" role="search">
                            <label for="navSearch" class="visually-hidden">بحث عن طالب</label>
                            <input id="navSearch" type="search" name="searchTerm" value="@currentSearch"
                                   class="form-control app-search-input"
                                   placeholder="ابحث عن طالب..." autocomplete="off" />
                        </form>

                        <button type="button" id="themeToggle" class="btn app-icon-btn"
                                aria-label="تبديل الوضع الداكن" aria-pressed="false">
                            <span data-theme-icon aria-hidden="true">🌙</span>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- ================= إشعارات (Toasts) ================= -->
    <div class="toast-container position-fixed top-0 start-50 translate-middle-x p-3 app-toasts">
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="toast app-toast app-toast-success" role="status" aria-live="polite" data-bs-delay="4000">
                <div class="d-flex align-items-center">
                    <div class="toast-body">@successMessage</div>
                    <button type="button" class="btn-close btn-close-white ms-2 me-2" data-bs-dismiss="toast" aria-label="إغلاق"></button>
                </div>
            </div>
        }
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="toast app-toast app-toast-error" role="alert" aria-live="assertive" data-bs-delay="7000">
                <div class="d-flex align-items-center">
                    <div class="toast-body">@errorMessage</div>
                    <button type="button" class="btn-close btn-close-white ms-2 me-2" data-bs-dismiss="toast" aria-label="إغلاق"></button>
                </div>
            </div>
        }
    </div>

    <!-- ================= المحتوى الرئيسي ================= -->
    <main id="main-content" class="app-main container" tabindex="-1">
        @RenderBody()
    </main>

    <!-- ================= الفوتر ================= -->
    <footer class="app-footer">
        <div class="container d-flex flex-column flex-sm-row justify-content-between gap-1">
            <span>نظام إدارة الطلاب والأقسام</span>
            <span>&copy; @DateTime.Now.Year · ASP.NET Core MVC</span>
        </div>
    </footer>

    <!-- ================= السكريبتات ================= -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>